# Bussola AI — Variabili d'ambiente (TEMPLATE)
# Copia questo file in ".env" e inserisci i valori reali.
# ⚠️ NON mettere mai valori segreti in questo file, nel repository o nel frontend.
# I segreti veri vivono solo come variabili d'ambiente lato server (es. Netlify env, Supabase).

# --- Supabase ---
# Pubbliche (possono stare nel frontend):
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SEGRETA — solo lato server, MAI nel browser o in Git:
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (Assistente Editoriale) ---
# SEGRETA — solo lato server:
OPENAI_API_KEY=

# --- Provider email / Newsletter (ESP, da scegliere) ---
# SEGRETA — solo lato server:
EMAIL_PROVIDER_API_KEY=

# --- Sito ---
SITE_URL=https://bussolaai.netlify.app
